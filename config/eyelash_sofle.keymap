#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        UA_AA: UA_AA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp APOS>, <&kp A>;
        };
        UA_EE: UA_EE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp APOS>, <&kp E>;
        };
        UA_II: UA_II {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp APOS>, <&kp I>;
        };
        UA_OO: UA_OO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp APOS>, <&kp O>;
        };
        UA_UU: UA_UU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp APOS>, <&kp U>;
        };
        UA_NN: UA_NN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp LS(GRAVE)>, <&kp N>;
        };
        UA_UUML: UA_UUML {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp LS(APOS)>, <&kp U>;
        };
        UA_IE: UA_IE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp EQUAL>;
        };
        UA_IQ: UA_IQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LS(EQUAL)>;
        };
        UA_BTICK: UA_BTICK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <5>;
            bindings = <&kp LBKT>, <&kp SPACE>;
        };
        ctrl_z: ctrl_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(Z)>;
        };
        ctrl_x: ctrl_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(X)>;
        };
        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(C)>;
        };
        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LC(V)>;
        };
        UA_LBRC: UA_LBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(APOS)>;
        };
        UA_RBRC: UA_RBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(BSLH)>;
        };
        UA_LBRKT: UA_LBRKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(LBKT)>;
        };
        UA_RBRKT: UA_RBRKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(RBKT)>;
        };
        UA_AT: UA_AT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(N2)>;
        };
        UA_HASH: UA_HASH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(N3)>;
        };
        UA_PIPE: UA_PIPE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp RA(N1)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC      &kp N1      &kp N2       &kp N3       &kp N4       &kp N5        &kp UP_ARROW     &kp N6       &kp N7       &kp N8       &kp N9        &kp N0          &kp MINUS
&kp TAB      &kp W       &kp L        &kp Y        &kp P        &kp B         &kp DOWN_ARROW   &kp F        &kp J        &kp O        &kp U         &kp SEMI        &UA_BTICK
&kp LCTRL    &kp C       &kp R        &kp S        &kp T        &kp G         &kp LEFT_ARROW   &kp M        &kp N        &kp E        &kp I         &kp A           &kp APOS
&kp LSHFT    &kp Q       &kp Z        &kp V        &kp D        &kp K         &kp RIGHT_ARROW  &kp X        &kp H        &kp COMMA    &kp DOT       &kp FSLH         &kp RSHFT
&kp C_MUTE   &kp LCTRL   &kp LALT     &kp LGUI     &mo 2        &kp SPACE     &kp ENTER        &kp ENTER    &mo 1    &kp BACKSPACE    &kp DELETE      &kp RALT
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "CANARIA";
        };

        layer_1 {
            bindings = <
&kp LS(N5)   &kp LS(N2)  &UA_AT       &UA_HASH     &kp LS(N4)   &kp LS(N6)    &kp UP_ARROW     &trans       &trans       &trans       &trans       &trans      &kp DELETE
&UA_LBRC     &kp LS(N8)  &kp LS(N9)  &UA_LBRKT    &UA_RBRKT    &UA_RBRC      &kp DOWN_ARROW   &UA_IQ     &trans       &UA_OO       &UA_UU        &trans      &trans
&kp LS(FSLH) &kp LS(N0)  &kp FSLH    &kp LS(DOT)  &kp LS(N1)   &kp LS(MINUS)  &kp LEFT_ARROW   &UA_IE       &UA_UUML       &UA_EE       &UA_II        &UA_AA          &trans
&UA_PIPE     &kp LS(N7)  &kp LS(RBKT) &kp RBKT     &kp NON_US_BACKSLASH       &kp LS(NON_US_BACKSLASH)     &kp RIGHT_ARROW  &trans       &trans       &trans       &trans        &trans          &trans
&trans       &trans      &trans       &trans        &mo 3       &trans        &trans           &trans       &trans       &trans       &trans        &trans
            >;

            display-name = "SYM+ACC";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&kp F12           &kp F1            &kp F2            &kp F3            &kp F4            &kp F5            &mmv MOVE_UP       &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans            &kp PG_UP         &kp HOME          &kp UP            &kp END           &trans            &mmv MOVE_DOWN     &trans   &trans  &trans  &trans  &trans   &trans
&trans            &trans            &kp LEFT          &kp DOWN          &kp RIGHT         &trans            &mmv MOVE_LEFT     &trans   &trans  &trans  &trans  &trans   &trans
&trans            &ctrl_z           &ctrl_x           &ctrl_c           &ctrl_v           &trans            &mmv MOVE_RIGHT    &trans   &trans  &trans  &trans  &trans   &trans
&trans            &trans            &trans            &trans            &trans            &trans             &mkp LCLK      &trans            &mo 3        &trans    &trans    &trans
            >;

            display-name = "NAV+SYS";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4      &bt BT_CLR        &trans            &trans   &trans   &trans   &trans   &trans    &trans
&rgb_ug RGB_OFF   &rgb_ug RGB_ON    &rgb_ug RGB_EFF   &trans            &rgb_ug RGB_SPI   &rgb_ug RGB_BRI    &trans            &trans   &trans   &trans   &trans   &trans    &trans
&trans            &trans            &trans            &trans            &trans            &trans            &trans            &rgb_ug RGB_BRD  &bt BT_CLR_ALL  &out OUT_USB  &out OUT_BLE  &trans   &trans
&trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans   &trans   &trans   &trans   &trans    &trans
&trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans   &trans   &trans   &trans   &trans
            >;

            display-name = "BT+RGB";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "EMPTY";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
